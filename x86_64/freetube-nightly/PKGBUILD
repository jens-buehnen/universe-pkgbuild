_pkgname=freetube
pkgname=${_pkgname}-nightly
pkgver=0.25.1.build7588.8e4ca31
pkgrel=1
pkgdesc="A private YouTube client (nightly build)"
arch=('x86_64')
url="https://github.com/FreeTubeApp/FreeTube"
license=('AGPL-3.0-or-later')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
makedepends=('curl' 'jq')
depends=(
  'c-ares'
  'ffmpeg'
  'gtk3'
  'http-parser'
  'libevent'
  'libvpx'
  'libxslt'
  'libxss'
  'minizip'
  'nss'
  're2'
  'snappy'
  'libnotify'
  'libappindicator-gtk3'
  'ttf-liberation'
)
install=$pkgname.install
source=("https://github.com/jens-buehnen/freetube-nightly/releases/latest/download/freetube.pacman.tar.xz")
sha256sums=('SKIP')

pkgver() {
  curl -s https://api.github.com/repos/jens-buehnen/freetube-nightly/releases/latest | jq -r '.tag_name'
}

package() {
  install -d "$pkgdir/opt/FreeTube"
  cp -r "${srcdir}/opt/" "${pkgdir}/"
  cp -r "${srcdir}/usr/" "${pkgdir}/"
}
