pkgname=('xremap-dotfiles')
pkgver=r5.44ded85
pkgrel=1
pkgdesc='my xremap configs'
arch=('any')
depends=('xremap-wlroots')
source=('git+https://github.com/jens-buehnen/dotfiles.git')
sha256sums=('SKIP')
groups=('dotfiles')

pkgver() {
	cd dotfiles
	printf "r%s.%s" "$(git rev-list --count HEAD -- xremap)" "$(git log -1 --format="%h" -- xremap)"
}

package() {
	mkdir -p "${pkgdir}/usr/share/dotfiles"
	cp -r "${srcdir}/dotfiles/xremap" "${pkgdir}/usr/share/dotfiles"
}
