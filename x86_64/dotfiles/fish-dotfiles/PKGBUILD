pkgname=('fish-dotfiles')
pkgver=1
pkgrel=1
pkgdesc='my fish configs'
arch=('any')
depends=('fish' 'zoxide' 'eza' 'yay' 'eza' 'ripgrep' 'fd' 'doas')
optdepends=('topgrade' 'git' 'ladybird' 'mpv' 'tar' 'hyfetch' 'unp')

pkgver() {
	printf "r%s.%s" "$(git rev-list --count HEAD -- fish)" "$(git log -1 --format="%h" -- fish)"
}

package() {
	mkdir -p "${pkgdir}/usr/share/dotfiles"
	cp -r "${srcdir}/dotfiles/fish" "${pkgdir}/usr/share/dotfiles"
}
