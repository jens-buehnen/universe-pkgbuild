pkgname=('mango-dotfiles')
pkgver=r42.7d15671
pkgrel=1
pkgdesc='my mango configs'
arch=('any')
depends=('mangowm' 'wl-clip-persist' 'wlr-which-key' 'xdg-desktop-portal-wlr' 'xdg-desktop-portal-gtk' 'ttf-jetbrains-mono-nerd' 'ttf-twemoji' 'papirus-icon-theme' 'bibata-cursor-theme' 'brightnessctl' 'sound-theme-freedesktop' 'wireplumber' 'noctalia')
source=('git+https://github.com/jens-buehnen/dotfiles.git')
sha256sums=('SKIP')
groups=('dotfiles')

pkgver() {
	cd dotfiles
	printf "r%s.%s" "$(git rev-list --count HEAD -- mango)" "$(git log -1 --format="%h" -- mango)"
}

package() {
	mkdir -p "${pkgdir}/usr/share/dotfiles"
	cp -r "${srcdir}/dotfiles/mango" "${pkgdir}/usr/share/dotfiles"
}
