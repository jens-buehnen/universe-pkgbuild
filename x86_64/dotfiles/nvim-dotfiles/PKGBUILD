pkgname=('nvim-dotfiles')
pkgver=r17.4e4676c
pkgrel=1
pkgdesc='my neovim configs'
arch=('any')
depends=('neovim' 'python-black' 'taplo-cli' 'shfmt' 'jq' 'stylua' 'git' 'curl' 'rust-analyzer' 'tree-sitter-cli' 'pyright' 'lua-language-server' 'bash-language-server')
source=('git+https://github.com/jens-buehnen/dotfiles.git')
sha256sums=('SKIP')
groups=('dotfiles')

pkgver() {
	cd dotfiles
	printf "r%s.%s" "$(git rev-list --count HEAD -- nvim)" "$(git log -1 --format="%h" -- nvim)"
}

package() {
	mkdir -p "${pkgdir}/usr/share/dotfiles"
	cp -r "${srcdir}/dotfiles/nvim" "${pkgdir}/usr/share/dotfiles"
}
