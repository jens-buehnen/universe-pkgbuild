package_wlogout-dotfiles() {
  depends=('wlogout')
  pkgdesc='my wlogout configs'
  mkdir -p "${pkgdir}/usr/share/catppuccin/wlogout/assets/"
  mkdir -p "${pkgdir}/usr/share/dotfiles"
  cp ${srcdir}/*.svg "${pkgdir}/usr/share/catppuccin/wlogout/assets"
  cp -r ${srcdir}/dotfiles/wlogout "${pkgdir}/usr/share/dotfiles"
}

