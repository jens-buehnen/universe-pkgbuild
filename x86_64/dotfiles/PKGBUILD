pkgname=("fastfetch-dotfiles" "jolt-dotfiles" "swaylock-dotfiles" "xremap-dotfiles" "fish-dotfiles" "fuzzel-dotfiles" "topgrade-dotfiles" "alacritty-dotfiles" "mpv-dotfiles" "mango-dotfiles" "nvim-dotfiles" "waybar-dotfiles" "wlr-which-key-dotfiles" "yay-dotfiles" "dotfiles-cli")
pkgver=r132.f76f913
pkgrel=1
pkgdesc="my personal dotfiles"
arch=('any')
source=('git+https://github.com/jens-buehnen/dotfiles.git')
sha256sums=('SKIP')
groups=(dotfiles)

pkgver() {
	cd dotfiles
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

copy() {
	mkdir -p "${pkgdir}/usr/share/dotfiles"
	cp -r "${srcdir}/dotfiles/$1" "${pkgdir}/usr/share/dotfiles"
}

package_fastfetch-dotfiles() {
	depends=('fastfetch')
	pkgdesc='my fastfetch configs'
	copy fastfetch
}

package_fish-dotfiles() {
	depends=('fish' 'fisher' 'zoxide' 'neovim' 'yay' 'fzf' 'eza' 'ripgrep' 'fd' 'doas')
	optdepends=('topgrade' 'git' 'ladybird' 'mpv' 'niri-screen-time' 'tar' 'hyfetch')
	pkgdesc='my fish configs'
	copy fish
}

package_fuzzel-dotfiles() {
	depends=('fuzzel' 'ttf-jetbrains-mono-nerd')
	pkgdesc='my fuzzel configs'
