package_niri-dotfiles() {
  depends=('niri' 'wl-clipboard' 'ttf-twemoji' 'swaybg' 'fd' 'papirus-icon-theme' 'remove-adwaita' 'catppuccin-gtk-theme-mocha-pink' 'chameleos' 'niri-screen-time' 'waybar' 'bibata-cursor-theme' 'mate-polkit' 'bemoji' 'brightnessctl' 'sound-theme-freedesktop' 'wireplumber' 'cliphist')
  optdepends=('vesktop' 'stasis' 'steam')
  pkgdesc='my niri configs'
  mkdir -p "${pkgdir}/usr/share/dotfiles"
  cp -r ${srcdir}/dotfiles/niri "${pkgdir}/usr/share/dotfiles"
}

