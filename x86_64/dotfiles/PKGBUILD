pkgname=("fastfetch-dotfiles" "jolt-dotfiles" "fish-dotfiles" "fuzzel-dotfiles" "topgrade-dotfiles" "alacritty-dotfiles" "mpv-dotfiles" "mango-dotfiles" "nvim-dotfiles" "swaylock-dotfiles" "waybar-dotfiles" "wlogout-dotfiles" "yay-dotfiles" "dotfiles-cli")
pkgver=r55.590f887
pkgrel=1
pkgdesc="my personal dotfiles"
arch=('any')
source=('git+https://github.com/jens-buehnen/dotfiles.git' 'https://github.com/catppuccin/wlogout/raw/refs/heads/main/icons/wlogout/mocha/pink/hibernate.svg' 'https://github.com/catppuccin/wlogout/raw/refs/heads/main/icons/wlogout/mocha/pink/lock.svg' 'https://github.com/catppuccin/wlogout/raw/refs/heads/main/icons/wlogout/mocha/pink/logout.svg' 'https://github.com/catppuccin/wlogout/raw/refs/heads/main/icons/wlogout/mocha/pink/reboot.svg' 'https://github.com/catppuccin/wlogout/raw/refs/heads/main/icons/wlogout/mocha/pink/shutdown.svg' 'https://github.com/catppuccin/wlogout/raw/refs/heads/main/icons/wlogout/mocha/pink/suspend.svg')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')
groups=(dotfiles)

pkgver() {
  cd dotfiles
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package_fastfetch-dotfiles() {
  depends=('fastfetch')
  pkgdesc='my fastfetch configs'
  mkdir -p "${pkgdir}/usr/share/dotfiles"
  cp -r ${srcdir}/dotfiles/fastfetch "${pkgdir}/usr/share/dotfiles"
}

package_fish-dotfiles() {
  depends=('fish' 'zoxide' 'hyfetch' 'neovim' 'yay' 'starship' 'fzf' 'eza' 'ripgrep' 'fd' 'doas')
  optdepends=('topgrade' 'git' 'ladybird' 'mpv' 'niri-screen-time' 'tar')
  pkgdesc='my fish configs'
  mkdir -p "${pkgdir}/usr/share/dotfiles"
  cp -r ${srcdir}/dotfiles/fish "${pkgdir}/usr/share/dotfiles"
}

