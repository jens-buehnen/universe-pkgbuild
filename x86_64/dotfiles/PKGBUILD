package_dotfiles() {
  pkgdesc='all of my dotfiles'
  depends=(
    'fastfetch-dotfiles' 'fish-dotfiles' 'fuzzel-dotfiles' 'ghostty-dotfiles' 'mpv-dotfiles' 'niri-dotfiles' 'nvim-dotfiles' 'swaylock-dotfiles' 'waybar-dotfiles' 'wlogout-dotfiles' 'yay-dotfiles' 'dotfiles-cli'
  )
}

package_dotfiles-cli() {
  pkgdesc='a cli to install all dotfiles'
  mkdir -p "$pkgdir/usr/bin"
  install -D -m755 ../dotfiles-cli "${pkgdir}/usr/bin"
}
