pkgbase=dotfiles
pkgname=({fastfetch-,fish-,fuzzel-,ghostty-,mpv-,niri-,nvim-,swaylock-,waybar-,wlogout-,yay-,}"${pkgbase}" "${pkgbase}-cli")
pkgver=1.2.17
pkgrel=3
pkgdesc="my personal dotfiles"
arch=('any')
source=('git+https://github.com/jens-buehnen/dotfiles.git')
sha256sums=('SKIP')
depends=('universe-meta')

package_fastfetch-dotfiles() {
  pkgdesc='my fastfetch configs'
  mkdir -p "${pkgdir}/usr/share/dotfiles"
  cp -r ${srcdir}/dotfiles/fastfetch "${pkgdir}/usr/share/dotfiles"
}

package_fish-dotfiles() {
  pkgdesc='my fish configs'
  mkdir -p "${pkgdir}/usr/share/dotfiles"
  cp -r ${srcdir}/dotfiles/fish "${pkgdir}/usr/share/dotfiles"
}

package_fuzzel-dotfiles() {
  pkgdesc='my fuzzel configs'
  mkdir -p "${pkgdir}/usr/share/dotfiles"
  cp -r ${srcdir}/dotfiles/fuzzel "${pkgdir}/usr/share/dotfiles"
