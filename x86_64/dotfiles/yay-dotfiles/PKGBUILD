pkgname=('yay-dotfiles')
pkgver=1
pkgrel=1
pkgdesc='my yay configs'
arch=('any')
depends=('yay')

pkgver() {
	printf "r%s.%s" "$(git rev-list --count HEAD -- yay)" "$(git log -1 --format="%h" -- yay)"
}

package() {
	mkdir -p "${pkgdir}/usr/share/dotfiles"
	cp -r "${srcdir}/dotfiles/yay" "${pkgdir}/usr/share/dotfiles"
}
