  'wl-clipboard' 'chameleos' 'bibata-cursor-theme' 'ttf-twemoji' 'ttf-jetbrains-mono-nerd'
)

package_universe-meta-niri() {
  pkgdesc='meta packages for my niri configuration'
  depends=(
    'niri' 'cliphist' 'brightnessctl' 'waybar' 'mpv' 'bemoji' 'sound-theme-freedesktop' 'fuzzel' 'wlogout' 'swaylock' 'mate-polkit' 'niri-screen-time'
    'wl-clipboard' 'chameleos' 'bibata-cursor-theme' 'ttf-twemoji' 'ttf-jetbrains-mono-nerd' 'papirus-icon-theme' 'ghostty' 'btop' 'bluetui' 'wiremix'
  )
  optdepends=(
    'steam: steam autostarting'
    'vesktop: vesktop autostarting'
    'stasis: idle manager'
  )
  provides=('niri-dots')
}

