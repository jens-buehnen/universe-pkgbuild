pkgname=mangowm
pkgver=0.12.8
pkgrel=1
pkgdesc="A Wayland compositor with smooth animation"
url="https://github.com/DreamMaoMao/mangowc"
arch=("x86_64")
license=("GPL-3.0")
depends=('glibc' 'wayland>=1.23.1' 'libinput>=1.27.1' 'libdrm' 'pixman' 'libxkbcommon' 'pcre2' 'libwlroots-0.19.so' 'scenefx0.4')
provides=('wayland-compositor' 'mangowc')
conflicts=( 'mangowc')
makedepends=('meson' 'ninja' 'wayland-protocols>=1.41')

source=("https://github.com/mangowm/mango/archive/refs/tags/$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "mango-$pkgver"
  meson build --prefix /usr
}

package() {
  cd "mango-$pkgver"
  DESTDIR="$pkgdir/" ninja -C build install
}


