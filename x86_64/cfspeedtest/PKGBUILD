pkgname=cfspeedtest
pkgver=2.2.0
pkgrel=1
pkgdesc="Unofficial CLI for speed.cloudflare.com"
arch=('x86_64')
url="https://github.com/code-inflation/cfspeedtest"
license=('MIT')
depends=('glibc' 'gcc-libs')
provides=("cfspeedtest")
conflicts=("cfspeedtest")
source=("https://github.com/code-inflation/cfspeedtest/releases/latest/download/cfspeedtest-x86_64-unknown-linux-gnu.tar.gz" "https://github.com/code-inflation/cfspeedtest/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP' 'SKIP')

pkgver() {
  curl -s https://api.github.com/repos/code-inflation/cfspeedtest/releases/latest | jq -r '.tag_name' | sed 's/^.//'
}

package() {
  install -Dm755 "$srcdir/cfspeedtest" "$pkgdir/usr/bin/cfspeedtest"
  install -Dm644 "$srcdir/cfspeedtest-${pkgver}/LICENSE.txt" "$pkgdir/usr/share/licenses/cfspeedtest/LICENSE.txt"

  install -dm755 "$pkgdir/usr/share/bash-completion/completions" &&
    "$srcdir/cfspeedtest" --generate-completion bash > \
      "$pkgdir/usr/share/bash-completion/completions/cfspeedtest"
  install -dm755 "$pkgdir/usr/share/zsh/site-functions" &&
    "$srcdir/cfspeedtest" --generate-completion zsh > \
      "$pkgdir/usr/share/zsh/site-functions/_cfspeedtest"
  install -dm755 "$pkgdir/usr/share/fish/vendor_completions.d" &&
    "$srcdir/cfspeedtest" --generate-completion fish > \
      "$pkgdir/usr/share/fish/vendor_completions.d/cfspeedtest.fish"
}
