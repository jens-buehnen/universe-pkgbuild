pkgname=wooz-git
pkgver=r189.24e2856
pkgrel=1
pkgdesc='zoom / magnifier utility for Wayland'
arch=(x86_64)
url='https://github.com/negrel/wooz'
license=(MIT)
depends=(wayland)
makedepends=(git meson ninja pango wayland-protocols)
provides=("wooz")
conflicts=("wooz")
source=("git+$url")
sha256sums=('SKIP')

pkgver() {
	# Git, no tags available
	cd "$srcdir/wooz"
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
	arch-meson -Dwerror=false build wooz
	ninja -C build
}

package() {
	DESTDIR="$pkgdir" ninja -C build install
	install -Dm644 wooz/LICENSE "$pkgdir/usr/share/licenses/wooz/LICENSE"
}
