pkgname=catppuccin-gtk-theme-mocha-pink
pkgver=1.0.6
pkgrel=1
pkgdesc='Soothing pastel theme for GTK - Mocha Pink'
arch=('any')
license=('GPL3')
url='https://github.com/VanillaDaFur/catppuccin-gtk'
source=(
  "$pkgname-$pkgver-pink.zip::$url/releases/download/v$pkgver/catppuccin-mocha-pink-standard.zip"
)

sha256sums=('SKIP')
package() {
  install -d "$pkgdir/usr/share/themes"
  cp -r -a --no-preserve=ownership \
    catppuccin-mocha-* "$pkgdir/usr/share/themes"
}
